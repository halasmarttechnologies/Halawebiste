# ─────────────────────────────────────────────────────────────────────────────
# Hala Technologies — Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Google reCAPTCHA ─────────────────────────────────────────────────────────
# Get from: https://www.google.com/recaptcha/admin (v2 Checkbox)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key_here

# ─── Resend (Email Service) ───────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# Get from: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-18
# Generate a strong random secret for webhook signature verification (e.g. openssl rand -hex 32)
SANITY_REVALIDATE_SECRET=your_strong_random_webhook_secret_here
# Get from Sanity dashboard > API > Tokens (Viewer/Editor/Admin)
SANITY_API_WRITE_TOKEN=your_sanity_write_token_here

# ─── Sentry Error Monitoring (Optional) ───────────────────────────────────────
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ─── Application URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Cryptography & Auth (If Payload / Custom Auth is used) ───────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
PAYLOAD_SECRET=your_payload_secret_here

# ─── Database URI (Optional / Neon Postgres) ──────────────────────────────────
DATABASE_URI=postgresql://user:password@host/database?sslmode=require

# ─── Cloudinary (Optional Media Storage) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
